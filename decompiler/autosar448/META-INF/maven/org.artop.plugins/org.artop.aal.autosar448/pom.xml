<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.artop.releng</groupId>
		<artifactId>org.artop.releng.parent</artifactId>
		<version>4.13.0-SNAPSHOT</version>
		<relativePath>../../../../core/tools/org.artop.releng.builds/parent/pom.xml</relativePath>
	</parent>
	<groupId>org.artop.plugins</groupId>
	<artifactId>org.artop.aal.autosar448</artifactId>
	<version>4.13.0-SNAPSHOT</version>
	<packaging>eclipse-plugin</packaging>
	<name>org.artop.aal.autosar448</name>
	<properties>
        <findbugs.skip>true</findbugs.skip>
		<checkstyle.skip>true</checkstyle.skip>
		<pmd.skip>true</pmd.skip>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>src</directory>
							<includes>
								<include>**/*</include>
							</includes>
							<excludes>
								<exclude>readme.txt</exclude>
							</excludes>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>truezip-maven-plugin</artifactId>
				<version>1.2</version>
				<executions>
					<execution>
						<id>clean-unpacked-sources</id>
						<phase>clean</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<files>
								<file>
									<source>${basedir}/releng/original/MANIFEST.MF</source>
									<outputDirectory>${basedir}/META-INF</outputDirectory>
								</file>
							</files>
						</configuration>
					</execution>
					<execution>
						<id>unpack-sources</id>
						<phase>process-sources</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<filesets>
								<fileset>
									<directory>${basedir}/lib/autosar40src.zip</directory>
									<outputDirectory>${basedir}/src</outputDirectory>
								</fileset>
							</filesets>
							<files>
								<file>
									<source>${basedir}/releng/MANIFEST.MF</source>
									<outputDirectory>${basedir}/META-INF</outputDirectory>
								</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
